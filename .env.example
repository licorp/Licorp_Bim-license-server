# =============================================
# BIM License Server — Environment Variables
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git!
# =============================================

# --- MongoDB Atlas (bắt buộc) ---
# Lấy từ: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI="mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/bim-manager?retryWrites=true&w=majority"

# --- JWT Secrets (bắt buộc - đặt chuỗi ngẫu nhiên dài) ---
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET="THAY_BANG_CHUOI_NGAU_NHIEN_DAI_64_KY_TU"
REFRESH_TOKEN_SECRET="THAY_BANG_CHUOI_NGAU_NHIEN_KHAC_DAI_64_KY_TU"

# --- Admin Key (bắt buộc) ---
ADMIN_SECRET_KEY="Licorp 2026"

# --- Admin Login cho giao diện web ---
VITE_ADMIN_USER="admin"
VITE_ADMIN_PASS="Admin@2024"
VITE_ADMIN_KEY="Licorp 2026"

# --- Server Config ---
PORT=3000
NODE_ENV=production
